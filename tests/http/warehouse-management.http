### Warehouse Management HTTP Tests
# This file tests all warehouse endpoints with proper authentication

### 1. Create a standard warehouse - should succeed
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Main Distribution Center",
  "capacity": 10000,
  "address": "123 Logistics Way",
  "city": "Dallas",
  "postalCode": "75201",
  "latitude": 32.7767,
  "longitude": -96.7970,
  "type": "STANDARD"
}

### 2. Create a warehouse with minimum fields - should succeed
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Small Warehouse",
  "capacity": 500,
  "address": "456 Storage Ave",
  "city": "Austin",
  "postalCode": "73301"
}

### 3. Create warehouse without name - should fail validation
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "",
  "capacity": 1000,
  "address": "789 Test Blvd",
  "city": "Houston",
  "postalCode": "77001"
}

### 4. Create warehouse with invalid coordinates - should fail validation
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Invalid Coords Warehouse",
  "capacity": 1000,
  "address": "321 Bad St",
  "city": "San Antonio",
  "postalCode": "78201",
  "latitude": 95.0,
  "longitude": -200.0
}

### 5. Create warehouse without authentication - should fail
POST {{baseUrl}}/api/admin/warehouses
Content-Type: application/json

{
  "name": "Unauthorized Warehouse",
  "capacity": 1000,
  "address": "999 No Auth St",
  "city": "Fort Worth",
  "postalCode": "76101"
}

### 6. Create warehouse with regular user token - should fail (requires admin)
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "name": "User Warehouse Attempt",
  "capacity": 1000,
  "address": "111 User St",
  "city": "El Paso",
  "postalCode": "79901"
}

##############################################################################
### GET SINGLE WAREHOUSE
##############################################################################

### 7. Get warehouse info by ID (replace {{warehouseId}} with actual ID from response above)
@warehouseId = PUT_WAREHOUSE_ID_HERE
GET {{baseUrl}}/api/admin/warehouses/{{warehouseId}}
Authorization: Bearer {{authToken}}

### 8. Get non-existent warehouse - should return 404
GET {{baseUrl}}/api/admin/warehouses/01234567-89ab-cdef-0123-456789abcdef
Authorization: Bearer {{authToken}}

### 9. Get warehouse with invalid UUID format - should fail
GET {{baseUrl}}/api/admin/warehouses/invalid-uuid
Authorization: Bearer {{authToken}}

##############################################################################
### LIST ALL WAREHOUSES
##############################################################################

### 10. List all warehouses
GET {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}

### 11. List warehouses without authentication - should fail
GET {{baseUrl}}/api/admin/warehouses

##############################################################################
### ACTIVATE WAREHOUSE
##############################################################################

### 12. Activate a warehouse (replace {{warehouseId}})
PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/activate
Authorization: Bearer {{authToken}}

### 13. Activate non-existent warehouse - should fail
PATCH {{baseUrl}}/api/admin/warehouses/01234567-89ab-cdef-0123-456789abcdef/activate
Authorization: Bearer {{authToken}}

### 14. Activate warehouse without authentication - should fail
PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/activate

##############################################################################
### DEACTIVATE WAREHOUSE
##############################################################################

### 15. Deactivate a warehouse (replace {{warehouseId}})
PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/deactivate
Authorization: Bearer {{authToken}}

### 16. Deactivate non-existent warehouse - should fail
PATCH {{baseUrl}}/api/admin/warehouses/01234567-89ab-cdef-0123-456789abcdef/deactivate
Authorization: Bearer {{authToken}}

### 17. Deactivate warehouse without authentication - should fail
PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/deactivate

##############################################################################
### WORKFLOW TEST
##############################################################################

### 18. Complete workflow: Create → List → Get → Activate → Deactivate
# Step 1: Create
POST {{baseUrl}}/api/admin/warehouses
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Workflow Test Warehouse",
  "capacity": 5000,
  "address": "555 Workflow Rd",
  "city": "Plano",
  "postalCode": "75074",
  "type": "STANDARD"
}

# Step 2: List all (verify warehouse appears)
# GET {{baseUrl}}/api/admin/warehouses
# Authorization: Bearer {{authToken}}

# Step 3: Get specific (use ID from step 1)
# GET {{baseUrl}}/api/admin/warehouses/{{warehouseId}}
# Authorization: Bearer {{authToken}}

# Step 4: Activate
# PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/activate
# Authorization: Bearer {{authToken}}

# Step 5: Deactivate
# PATCH {{baseUrl}}/api/admin/warehouses/{{warehouseId}}/deactivate
# Authorization: Bearer {{authToken}}
